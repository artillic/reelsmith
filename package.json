{
  "name": "reelsmith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automated trial-reel pipeline: hook variants -> b-roll -> rendered vertical video -> Metricool schedule -> hook performance ranking.",
  "bin": {
    "reel": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -R src/web dist/src/web",
    "dashboard": "node --experimental-strip-types src/cli.ts dashboard",
    "reel": "node --experimental-strip-types src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "sharp": "^0.34.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
