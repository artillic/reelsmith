# Copy to .env. Never commit .env — it is gitignored.

# --- Ideation ------------------------------------------------------------
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Metricool -----------------------------------------------------------
# API access requires a Metricool Advanced plan.
#
# TOKEN:   Metricool > Account Settings > API
# USER_ID: any dashboard URL — app.metricool.com/evolution/web?blogId=XXXX&userId=YYYY
# BLOG_ID: the brand you post from. Same URL, or run `npm run reel -- brands`
#          once TOKEN and USER_ID are filled in.
METRICOOL_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=

# Set these ONLY after the probe tells you what the fields are called. Metricool
# supports trial reels and trending audio in its Planner, but does not name
# either field in its public API docs — the probe reads them back off a post you
# scheduled by hand. Left unset, posts go out as ordinary reels with no track.
# METRICOOL_TRIAL_FIELD=
# METRICOOL_TRIAL_VALUE=true
# METRICOOL_AUDIO_FIELD=

# --- Media hosting -------------------------------------------------------
# Metricool fetches media over HTTP at PUBLISH time, so rendered mp4s must sit
# at a public URL that returns raw bytes. `reel upload` pushes them to a public
# Supabase Storage bucket and MEDIA_PUBLIC_BASE_URL is then derived for you.
#
# Supabase dashboard > Storage > New bucket, named below, toggled PUBLIC.
# The key is Project Settings > API > service_role (NOT the anon key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=reels

# Only needed if you host media somewhere other than Supabase. Overrides the
# derived Supabase URL above; you are then responsible for uploading.
# MEDIA_PUBLIC_BASE_URL=

# --- Optional ------------------------------------------------------------
# Stock b-roll fill for `reel render --stock`. https://www.pexels.com/api/
# PEXELS_API_KEY=

# Font used for the burned-in hook. Must be installed locally.
# REEL_FONT_FAMILY="Helvetica Neue, Arial, sans-serif"
